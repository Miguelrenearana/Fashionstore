# ==========================================================
# FashionStore - Variables de entorno (copiar a .env)
# NUNCA comitear .env con valores reales.
# ==========================================================

# ---------- Base ----------
APP_NAME="FashionStore API"
APP_ENV=development          # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ---------- Database (PostgreSQL + pgvector) ----------
# Local (docker compose):
DATABASE_URL=postgresql+psycopg://fashion:change-me@localhost:5432/fashionstore
# Neon (producciÃ³n): sustituir por la connection string pooler/direct del proyecto.
#DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>.neon.tech/fashionstore?sslmode=require

# ---------- Auth / JWT ----------
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ---------- Pagos (Gateway) ----------
# mock = desarrollo (siempre disponible). pagosnet = sandbox real (se activa bajo demanda).
PAYMENT_GATEWAY=mock
BASE_URL_APP=http://localhost:8000
PAGOSNET_API_KEY=
PAGOSNET_ENCRYPTION_KEY=
PAGOSNET_BASE_URL=https://sandbox.pagosnet.bo/api

# ---------- Email (Gmail App Password recomendado: SMTP_HOST=smtp.gmail.com,
#                SMTP_PORT=587, SMTP_USER=tucuenta@gmail.com,
#                SMTP_PASSWORD=<app password de 16 chars> (https://myaccount.google.com/apppasswords),
#                MAIL_FROM=tucuenta@gmail.com) ----------
# Si SMTP_PASSWORD queda vacío, el servicio cae a mock (log [email-mock]).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@fashionstore.dev

# ---------- IA / Recomendador ----------
RECOMMENDATION_EMBEDDING_MODEL=all-MiniLM-L6-v2
RECOMMENDATION_BATCH_SIZE=64