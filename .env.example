# FashionStore - Variables de Entorno
# Copia este archivo a .env y ajusta los valores

# ===========================================
# BACKEND (ASP.NET Core)
# ===========================================
ASPNETCORE_ENVIRONMENT=Development

# Connection Strings
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=FashionStore;User=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# JWT Configuration
Jwt__Key=your-super-secret-key-with-at-least-32-characters-long
Jwt__Issuer=FashionStore
Jwt__Audience=FashionStore.Client
Jwt__ExpiryMinutes=60

# Email (opcional)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=tu-email@gmail.com
Email__Password=tu-app-password
Email__FromName=FashionStore
Email__FromEmail=noreply@fashionstore.com

# File Storage (opcional - Azure Blob, AWS S3, etc.)
Storage__Provider=Local
Storage__LocalPath=wwwroot/uploads
Storage__AzureConnectionString=
Storage__AwsAccessKey=
Storage__AwsSecretKey=
Storage__AwsBucket=
Storage__AwsRegion=

# ===========================================
# FRONTEND (React + Vite)
# ===========================================
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=FashionStore
VITE_APP_URL=http://localhost:5173

# ===========================================
# DOCKER
# ===========================================
# SQL Server
SA_PASSWORD=YourStrong@Passw0rd
ACCEPT_EULA=Y
MSSQL_PID=Express

# ===========================================
# DESARROLLO
# ===========================================
# Para desarrollo local sin Docker, usa:
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=FashionStore;Trusted_Connection=True;MultipleActiveResultSets=true