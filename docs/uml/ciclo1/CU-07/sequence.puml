@startuml CU-07
actor "Cliente" as Cli
boundary "«UI» Angular (detalle)" as UI
control "«Controller» API /catalog /cart" as Ctrl
entity "«Model» CatalogService, CartService / garment, cart" as Model

Cli -> UI : Abrir detalle de prenda
UI -> Ctrl : GET /catalog/{id}
Ctrl -> Model : get(db, garment_id)
Model --> Ctrl : prenda con variantes, imágenes, stock
Ctrl --> UI : CatalogItemRead (variantes talla/color)

Cli -> UI : Seleccionar talla/color
UI -> Ctrl : POST /cart/items {variant_id, quantity}
Ctrl -> Model : add_item(db, cart, variant_id, 1)
Model --> Ctrl : carrito actualizado
Ctrl --> UI : CartRead
UI --> Cli : confirmación "Agregado al carrito"

@enduml