@startuml CU-12
actor "Admin / Manager" as Adm
boundary "«UI» Angular (sucursal/inventario)" as UI
control "«Controller» API /inventory" as Ctrl
entity "«Model» InventoryService / inventory, movement" as Model

Adm -> UI : Seleccionar sucursal
UI -> Ctrl : GET /inventory?branch_id=X
Ctrl -> Model : list(db, branch_id)
Model --> Ctrl : stock por variante (prenda, SKU, talla, color, reservado)
Ctrl --> UI : InventoryRead[]

Adm -> UI : Ajustar stock (+/-)
UI -> Ctrl : PATCH /inventory/{branch}/{variant}/adjust
Ctrl -> Model : adjust(db, branch, variant, quantity, reason)
Model --> Ctrl : inventario actualizado + movimiento registrado
Ctrl --> UI : InventoryRead
UI --> Adm : Stock y disponibilidad recalculados

Adm -> UI : Ver movimientos
UI -> Ctrl : GET /inventory/movements?branch_id=&variant_id=
Ctrl -> Model : list_movements(db, branch, variant)
Model --> Ctrl : historial IN/OUT
Ctrl --> UI : InventoryMovementRead[]

@enduml