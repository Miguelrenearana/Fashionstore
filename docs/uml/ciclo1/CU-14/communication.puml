@startuml CU-14
actor "Staff (caja)" as Staff
boundary "«UI» Angular / API clients" as UI
control "«Controller» API /sales, /reservations" as Ctrl
entity "«Model» SalesService / ReservationService / Inventory" as Model

Staff -> UI : 1: seleccionar reserva
UI -> Ctrl : 2: POST /sales {reservation_id}
Ctrl -> Model : 3: create_sale(db, reservation)
Model -> Model : 4: stock: quantity-- y reserved_quantity--
Model -> Model : 5: reserva → COMPLETED + historial
Model --> Ctrl : 6: Sale PENDING
Ctrl --> UI : 7: SaleRead
UI --> Staff : 8: venta registrada

Staff -> UI : 9: venta directa
UI -> Ctrl : 10: POST /sales {items}
Ctrl -> Model : 11: create_sale(db, items)
Model -> Model : 12: descuenta stock disponible
Model --> Ctrl : 13: Sale
Ctrl --> UI : 14: SaleRead

Staff -> UI : 15: consultar venta
UI -> Ctrl : 16: GET /sales/{id}
Ctrl -> Model : 17: get(db, sale_id)
Model --> Ctrl : 18: Sale + detalles
Ctrl --> UI : 19: SaleRead

@enduml