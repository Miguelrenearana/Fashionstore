@startuml CU-17
actor "Cliente" as Cli
boundary "«UI» Angular (detalle de producto)" as UI
control "«Controller» API /recommendations" as Ctrl
entity "«Service» AIService / RecommenderService / EmbeddingService" as Svc
database "«Store» pgvector (product_embeddings + ivfflat)" as DB

participant "«Task» recompute_embeddings" as Task

Task -> Svc : encode_batch(nombre+categoria+descripcion)
Svc -> DB : UPSERT embedding por variante
DB -> Task : ok (2 variantes)

Cli -> UI : Ver prenda X
UI -> Ctrl : POST /recommendations/view/{variant_id}
Ctrl -> Svc : log_view(client, variant)
Svc -> DB : historial_navegacion.view_count++
Cli -> UI : Revisar recomendaciones
UI -> Ctrl : GET /recommendations?source_variant_id=X
Ctrl -> Svc : recommend_for_client(client, source, limit)
Svc -> Svc : vector de consulta (source o mejor historial)
Svc -> DB : SELECT … embedding <=> vec ORDER BY … LIMIT n
DB --> Svc : variantes + score (coseno)
Svc -> DB : persistir recomendación (score)
Ctrl --> UI : RecommendationRead[] (nombre, sku, score, garment_id)
UI --> Cli : "También te puede interesar" + afinidad %

@enduml