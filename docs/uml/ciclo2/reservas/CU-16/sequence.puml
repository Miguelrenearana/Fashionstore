@startuml CU-16
actor "Cliente" as Cli
boundary "«UI» Angular (mis reservas)" as UI
control "«Controller» API /reservations" as Ctrl
entity "«Model» ReservationService / Reservation" as Model

Cli -> UI : Abre "Mis reservas"
UI -> Ctrl : GET /reservations
Ctrl -> Model : get_my_reservations(db, user_id, status?)
Model --> Ctrl : list[ReservationRead]
Ctrl --> UI : list[ReservationRead]
UI --> Cli : Reservas con estado y detalles

Cli -> UI : Cancela una reserva pendiente
UI -> Ctrl : PATCH /reservations/{id}/cancel
Ctrl -> Model : cancel(db, reservation, user) → transición a CANCELLED
Model -> Model : libera la cantidad reservada (reserved_quantity)
Model --> Ctrl : ReservationRead (CANCELLED)
Ctrl --> UI : ReservationRead
UI --> Cli : Reserva cancelada

@enduml